---
// Ledger redesign fonts — only the weights actually referenced in CSS right
// now (headings/em at Jost 600; nav, hero deck, and body text at Instrument
// Sans 400). Add more weights only alongside the CSS that uses them.
import "@fontsource/jost/600.css";
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";
import "@fontsource/instrument-sans/600.css";

import { SEO } from "astro-seo";

// interface Props {
//   title: string;
//   description?: string;
// }

// const { title, description } = Astro.props;

import "../styles/global.scss";

import Header from "../components/Header/Header.astro";
import Footer from "../components/Footer/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      title="Christina Reilly Portfolio"
      description="Senior web developer."
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
  </head>
  <body>
    <main>
      <Header />
      <slot />
      <Footer />
    </main>
  </body>
</html>
