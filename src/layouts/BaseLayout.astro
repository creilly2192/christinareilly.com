---
// Ledger redesign fonts — only the weights actually referenced in CSS right
// now (headings/em at Jost 600; nav, hero deck, and body text at Instrument
// Sans 400). Add more weights only alongside the CSS that uses them.
import "@fontsource/jost/600.css";
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";
import "@fontsource/instrument-sans/600.css";
// 90s-edition pixel accents: hero address bar + the header "hello" stamp.
import "@fontsource/vt323/400.css";

import { SEO } from "astro-seo";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Christina Reilly - Senior Web Developer",
  description = "I'm Christina Reilly, a senior web developer in Miami.",
} = Astro.props as Props;

import "../styles/global.scss";

import Header from "../components/Header/Header.astro";
import Footer from "../components/Footer/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <SEO title={title} description={description} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
  </head>
  <body>
    <main>
      {
        /* The header and an optional "hero" slot share one band so the star
          pattern tiles across both without a seam between them. */
      }
      <div
        class:list={[
          "hero-band",
          { "hero-band--pattern": Astro.slots.has("hero") },
        ]}
      >
        <Header />
        <slot name="hero" />
      </div>
      <slot />
      <Footer />
    </main>
  </body>
</html>
