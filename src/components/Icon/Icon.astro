---
// Ledger design system's line-icon set — stroke-based, 24x24, no icon font.
// Ported from public/designs/direction-a.jsx's `Icon` component. `baby` was
// replaced with `heart`: the "raising a tiny human" card is a durational
// state (SINCE tag), and a literal baby-bottle glyph read as too literal —
// see CLAUDE.md Open items.
// A leading-pipe multi-line union (Prettier's default for a union this long)
// breaks Astro's frontmatter compiler here, so the type is derived from an
// array instead — same shape, immune to that reformat.
const ICON_NAMES = [
  "book",
  "bookmark",
  "headphones",
  "code",
  "pencil",
  "mail",
  "github",
  "rss",
  "heart",
  "briefcase",
  "arrow-up-right",
] as const;
export type IconName = (typeof ICON_NAMES)[number];

type Props = {
  name: IconName;
  size?: number;
  color?: string;
  strokeWidth?: number;
};

const {
  name,
  size = 16,
  color = "currentColor",
  strokeWidth = 1.8,
} = Astro.props as Props;

// Each glyph is one or more segments, rendered as real <path>/<circle>
// elements below (not raw HTML) so nothing needs `set:html`.
type Segment =
  | { type: "path"; d: string; strokeWidth?: number }
  | { type: "circle"; cx: number; cy: number; r: number };

const glyphs: Record<IconName, Segment[]> = {
  book: [
    {
      type: "path",
      d: "M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5v-17Z",
    },
    { type: "path", d: "M4 19a2.5 2.5 0 0 1 2.5-2.5H20" },
  ],
  bookmark: [{ type: "path", d: "M6 3h12v18l-6-4.5L6 21V3Z" }],
  headphones: [
    {
      type: "path",
      d: "M4 14v-2a8 8 0 0 1 16 0v2M4 14a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h1a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1H4Zm16 0a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-1a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h1Z",
    },
  ],
  code: [{ type: "path", d: "m9 18-6-6 6-6m6 12 6-6-6-6" }],
  pencil: [
    {
      type: "path",
      d: "M12 20h9M4 20h1.5L18 7.5a1.5 1.5 0 0 0 0-2.12l-1.38-1.4a1.5 1.5 0 0 0-2.12 0L2 16.5V20Z",
    },
  ],
  mail: [
    { type: "path", d: "M3 6h18v12H3V6Z" },
    { type: "path", d: "m3 6 9 7 9-7" },
  ],
  github: [
    {
      type: "path",
      strokeWidth: 1.4,
      d: "M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.4 9.4 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.69 0 3.85-2.34 4.7-4.57 4.95.36.31.68.92.68 1.85v2.74c0 .26.18.58.69.48A10 10 0 0 0 12 2Z",
    },
  ],
  rss: [
    { type: "circle", cx: 5, cy: 19, r: 1.5 },
    { type: "path", d: "M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" },
  ],
  heart: [
    {
      type: "path",
      d: "M12 21s-7.5-4.6-10-9.3C.4 8.4 2 4.8 5.6 4.1 8 3.6 10.2 4.8 12 7c1.8-2.2 4-3.4 6.4-2.9 3.6.7 5.2 4.3 3.6 7.6C19.5 16.4 12 21 12 21Z",
    },
  ],
  briefcase: [
    {
      type: "path",
      d: "M3 8.5A1.5 1.5 0 0 1 4.5 7h15A1.5 1.5 0 0 1 21 8.5v10A1.5 1.5 0 0 1 19.5 20h-15A1.5 1.5 0 0 1 3 18.5v-10Z",
    },
    {
      type: "path",
      d: "M8 7V5.5A1.5 1.5 0 0 1 9.5 4h5A1.5 1.5 0 0 1 16 5.5V7M3 12h18",
    },
  ],
  "arrow-up-right": [{ type: "path", d: "M7 17 17 7M9 7h8v8" }],
};
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke={color}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    glyphs[name].map((seg) =>
      seg.type === "circle" ? (
        <circle cx={seg.cx} cy={seg.cy} r={seg.r} fill={color} stroke="none" />
      ) : (
        <path d={seg.d} stroke-width={seg.strokeWidth ?? strokeWidth} />
      ),
    )
  }
</svg>
