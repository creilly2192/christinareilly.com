---
// Ledger design system's changelog-style metadata tag — "since [date]" on
// Working On / Listening cards, "returned [date]" on finished reads. No
// checked-out variant: currently-reading books show no date (see CLAUDE.md
// Decisions — Christina's call, a deliberate deviation from the mockup).
type Props = {
  variant: "since" | "returned";
  date: string;
  label?: string; // override the displayed word, e.g. "on repeat since"
  class?: string; // Astro does NOT auto-forward this — must be read + applied explicitly
};

const { variant, date, label, class: className } = Astro.props as Props;
---

<span class:list={["status-tag", `status-tag--${variant}`, className]}>
  {label ?? variant}
  {date}
</span>

<style lang="scss">
  @use "./StatusTag.scss";
</style>
