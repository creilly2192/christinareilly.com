---
// Ledger design system's changelog-style metadata tag — "since [date]" on
// Working On / Listening cards, "returned [date]" on finished reads,
// "reading" for the reading-log's dateless "in progress" tag (no date on
// this variant — see CLAUDE.md Decisions: currently-reading books never
// show a checked-out date, a deliberate deviation from the mockup).
type Props = {
  variant: "since" | "returned" | "reading";
  date?: string;
  label?: string; // override the displayed word, e.g. "on repeat since", "in progress"
  class?: string; // Astro does NOT auto-forward this — must be read + applied explicitly
};

const { variant, date, label, class: className } = Astro.props as Props;
---

<span class:list={["status-tag", `status-tag--${variant}`, className]}>
  {label ?? variant}
  {date}
</span>

<style lang="scss">
  @use "./StatusTag.scss";
</style>
