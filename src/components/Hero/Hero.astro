<section class="hero-main">
  <div class="container">
    <div class="hero-main__window">
      <div class="hero-main__title-bar" aria-hidden="true">
        <span class="hero-main__dot hero-main__dot--a"></span>
        <span class="hero-main__dot hero-main__dot--b"></span>
        <span class="hero-main__dot hero-main__dot--c"></span>
      </div>
      <div class="hero-main__toolbar">
        <div class="hero-main__address">
          <span class="hero-main__favicon" aria-hidden="true">✦</span>
          <span class="hero-main__url">
            https://www.<span class="hero-main__url-host">christinareilly</span
            >.com
          </span>
          <span class="hero-main__fave-wrap">
            <span
              class="hero-main__fave-burst"
              aria-hidden="true"
              data-fave-burst
            >
              <span
                class="hero-main__spark hero-main__spark--tangerine"
                style="--x: -34px; --y: -38px; --r: -40deg; --d: 0s; --s: 1.25rem"
                >✦</span
              >
              <span
                class="hero-main__spark hero-main__spark--sea"
                style="--x: -6px; --y: -50px; --r: 30deg; --d: 0.06s; --s: 1rem"
                >✧</span
              >
              <span
                class="hero-main__spark hero-main__spark--matcha"
                style="--x: 26px; --y: -42px; --r: 60deg; --d: 0.12s; --s: 1.375rem"
                >✦</span
              >
              <span
                class="hero-main__spark hero-main__spark--blush"
                style="--x: 52px; --y: -26px; --r: -20deg; --d: 0.04s; --s: 0.875rem"
                >♥</span
              >
              <span
                class="hero-main__spark hero-main__spark--blush"
                style="--x: -56px; --y: -18px; --r: 45deg; --d: 0.1s; --s: 0.875rem"
                >✧</span
              >
            </span>
            <button
              class="hero-main__fave"
              type="button"
              aria-pressed="false"
              data-fave
            >
              {
                /* One fixed name for screen readers; aria-pressed carries the
                  on/off state. The swapping visible text (and the hearts,
                  read aloud as "white heart suit") are hidden from them —
                  otherwise the state is announced twice. */
              }
              <span class="visually-hidden">add to favorites</span>
              <span class="hero-main__fave-off" aria-hidden="true">
                ♡ add to favorites
              </span>
              <span class="hero-main__fave-on" aria-hidden="true">
                ♥ added to favorites!
              </span>
            </button>
          </span>
        </div>
      </div>
      <div class="hero-main__content">
        <h1 class="hero-main__title">
          {/* Explicit space — Astro 7 drops the line break before the span. */}
          Christina makes things for the{" "}
          <span class="hero-main__accent">
            <span class="hero-main__accent-letter hero-main__accent-letter--w"
              >w</span
            >
            <span class="hero-main__accent-letter hero-main__accent-letter--e"
              >e</span
            >
            <span class="hero-main__accent-letter hero-main__accent-letter--b"
              >b</span
            >
          </span>.
        </h1>
        <p class="hero-main__deck">
          This site is where I keep track of what I’m reading, writing, and
          thinking about.
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Confirms a real paint has happened before starting the "web" entrance
  // bounce (see .js-loaded in Hero.scss) — an animation-delay alone counts
  // down from navigation start, so on a slow first load the animation can
  // silently finish before the page is ever visible. Double rAF is the
  // standard way to wait for "at least one frame has been painted."
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      document.documentElement.classList.add("js-loaded");
    });
  });
</script>

<script>
  // "Add to favorites" toggle in the fake address bar — purely decorative,
  // nothing is saved. Each "add" replays the star puff above the button:
  // dropping the class and forcing a reflow restarts the CSS animation.
  document.querySelectorAll<HTMLButtonElement>("[data-fave]").forEach((btn) => {
    const burst =
      btn.parentElement?.querySelector<HTMLElement>("[data-fave-burst]");
    btn.addEventListener("click", () => {
      const pressed = btn.getAttribute("aria-pressed") === "true";
      btn.setAttribute("aria-pressed", String(!pressed));
      if (!pressed && burst) {
        burst.classList.remove("is-bursting");
        void burst.offsetWidth;
        burst.classList.add("is-bursting");
      }
    });
  });
</script>

<style lang="scss">
  @use "./Hero.scss";
</style>
