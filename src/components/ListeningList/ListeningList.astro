      <div class="listening-list">
        {items.map((item) => (
          <div class="listening-list__content">
            <div class="listening-list__meta">
              <strong class="listening-list__title">{item.title}</strong>
              <span>by {item.artist} </span>
            </div>
            <p class="listening-list__note">
              <a
                href="https://www.albumlog.app/"
                target="_blank"
                rel="noopener noreferrer"
              >
                albumlog,
              </a>{" "}
              my project ranking the 500 greatest albums of all time
            </p>
          </div>
        ))}

        <div class="listening-list__record">
