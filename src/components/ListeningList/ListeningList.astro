---
import type { ListeningItem } from "../../data/now/now.types";
import Icon from "../Icon/Icon.astro";

type Props = { items?: ListeningItem[] };
const { items = [] } = Astro.props as Props;
---

<div class="section-now__grid-item">
  <h3 class="section-now__subheading">
    <Icon name="headphones" size={14} />Currently Listening
